# Public browser configuration. Use a Supabase publishable key, never a secret key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional development services.
VITE_REALTIME_URL=ws://127.0.0.1:8787
VITE_FREEFRAME_URL=http://localhost:3000
VITE_FREEFRAME_API_URL=http://localhost:8000
VITE_ENABLE_FREEFRAME=false

# Local demo access only. Production authentication will move to Supabase Auth.
VITE_ADMIN_CODE=change-me
